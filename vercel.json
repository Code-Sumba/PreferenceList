{
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://z79hp0oa5ojq2z38ey2pb6y4.200.97.171.63.sslip.io/api/:path*" },
    { "source": "/engine/:path*", "destination": "http://z79hp0oa5ojq2z38ey2pb6y4.200.97.171.63.sslip.io/engine/:path*" },
    { "source": "/admin/:path*", "destination": "http://z79hp0oa5ojq2z38ey2pb6y4.200.97.171.63.sslip.io/admin/:path*" },
    { "source": "/generated_pdfs/:path*", "destination": "http://z79hp0oa5ojq2z38ey2pb6y4.200.97.171.63.sslip.io/generated_pdfs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(logo.png|og-image.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}

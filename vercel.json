{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://web-production-bd442.up.railway.app/api/:path*" },
    { "source": "/engine/:path*", "destination": "https://web-production-bd442.up.railway.app/engine/:path*" },
    { "source": "/admin/:path*", "destination": "https://web-production-bd442.up.railway.app/admin/:path*" },
    { "source": "/generated_pdfs/:path*", "destination": "https://web-production-bd442.up.railway.app/generated_pdfs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
